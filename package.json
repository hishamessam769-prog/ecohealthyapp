{
  "name": "eco-healthy-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/lib/auth",
    "test:integration": "vitest run src/lib/domain",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test --config=playwright.hosted.config.ts",
    "sql:build": "node scripts/build-master-sql.mjs",
    "sql:validate": "python3 scripts/validate-sql.py",
    "sql:test:embedded": "node scripts/test-master-pglite.mjs",
    "sql:test:v12-upgrade": "node scripts/test-v12-upgrade-pglite.mjs",
    "staging:prepare": "node --env-file=.env.staging scripts/prepare-hosted-staging.mjs",
    "staging:install-master": "sh -c 'set -a; . ./.env.staging; set +a; sh scripts/install-hosted-master.sh'",
    "staging:verify": "node --env-file=.env.staging scripts/verify-hosted-staging.mjs",
    "test:watch": "vitest",
    "bootstrap:admin": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs",
    "seed:foundation-demo": "node --env-file-if-exists=.env.local scripts/seed-foundation-demo.mjs",
    "seed:acceptance-users": "node --env-file-if-exists=.env.local scripts/seed-acceptance-users.mjs",
    "cleanup:foundation-demo": "node --env-file-if-exists=.env.local scripts/cleanup-foundation-demo.mjs",
    "cleanup:acceptance-users": "node --env-file-if-exists=.env.local scripts/cleanup-acceptance-users.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.57.4",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.62.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
